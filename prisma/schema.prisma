generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Contact {
  id            String         @id @default(cuid())
  nom           String
  role          String
  categorie     String
  telephone     String
  telephoneAlt  String?
  note          String?
  disponibilite String?
  /// Rattachement optionnel à un secteur de référence (évolution métier)
  secteurId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  fiches        FicheContact[]
  secteur       Secteur?       @relation(fields: [secteurId], references: [id], onDelete: SetNull)
}

model Secteur {
  id          String         @id @default(cuid())
  slug        String         @unique
  nom         String
  ligne       String
  trajet      String
  description String
  pointsAcces String
  procedures  String
  pn          String?
  liens       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  fiches      FicheSecteur[]
  postes      PosteSecteur[]
  contacts    Contact[]
}

model Fiche {
  id               String         @id @default(cuid())
  slug             String         @unique
  numero           Int            @unique
  titre            String
  categorie        String
  priorite         String
  mnemonique       String?
  resume           String
  etapes           String
  references       String?
  avisObligatoires String?
  liens            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  featured         Boolean        @default(false)
  contacts         FicheContact[]
  secteurs         FicheSecteur[]
  documents        Document[]
  liensSource      FicheLien[]    @relation("FicheLienSource")
  liensCible       FicheLien[]    @relation("FicheLienCible")
}

/// Lien symétrique entre deux fiches (ex. fiche chapeau ↔ fiche dégradée).
/// L'auto-bidirectionnalité est garantie côté API : à chaque insertion d'un lien A→B,
/// le lien B→A est inséré dans la même transaction. Idem pour la suppression.
model FicheLien {
  id            String   @id @default(cuid())
  ficheSourceId String
  ficheCibleId  String
  createdAt     DateTime @default(now())
  source        Fiche    @relation("FicheLienSource", fields: [ficheSourceId], references: [id], onDelete: Cascade)
  cible         Fiche    @relation("FicheLienCible", fields: [ficheCibleId], references: [id], onDelete: Cascade)

  @@unique([ficheSourceId, ficheCibleId])
  @@index([ficheSourceId])
  @@index([ficheCibleId])
}

/// Document PDF téléchargeable, attaché à une Fiche OU à un Poste.
/// Le fichier physique est stocké sous ./uploads/documents/<id>.pdf (hors public/).
/// Document PDF téléchargeable, attaché à une Fiche OU à un Poste.
/// Le fichier physique est stocké sous ./uploads/documents/<id>.pdf (hors public/).
///
/// `uploadedByUserId` est nullable avec onDelete: SetNull — si l'utilisateur
/// est supprimé physiquement (hors application), le document reste accessible
/// avec un libellé "Téléversé par : (utilisateur supprimé)".
model Document {
  id               String   @id @default(cuid())
  filename         String
  originalName     String
  mimeType         String
  size             Int
  ficheId          String?
  posteId          String?
  /// DOCUMENT (PDF de référence) | PHOTO (image JPEG/PNG — tournées terrain).
  kind             String   @default("DOCUMENT")
  /// Légende facultative (photos illustratives d'étape de tournée).
  caption          String?
  /// Ordre d'affichage parmi les fichiers du même propriétaire.
  ordre            Int      @default(0)
  /// Photo illustrative d'une étape de MODÈLE de tournée (permanente,
  /// visible par tous les participants).
  tourneeEtapeId   String?
  /// Photo jointe à une contribution terrain.
  tourneeContributionId String?
  uploadedByUserId String?
  createdAt        DateTime @default(now())
  fiche            Fiche?   @relation(fields: [ficheId], references: [id], onDelete: Cascade)
  poste            Poste?   @relation(fields: [posteId], references: [id], onDelete: Cascade)
  tourneeEtape        TourneeEtape?        @relation(fields: [tourneeEtapeId], references: [id], onDelete: Cascade)
  tourneeContribution TourneeContribution? @relation(fields: [tourneeContributionId], references: [id], onDelete: Cascade)
  uploadedBy       User?    @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([ficheId])
  @@index([posteId])
  @@index([tourneeEtapeId])
  @@index([tourneeContributionId])
}

model FicheContact {
  ficheId   String
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  fiche     Fiche   @relation(fields: [ficheId], references: [id], onDelete: Cascade)

  @@id([ficheId, contactId])
}

model FicheSecteur {
  ficheId   String
  secteurId String
  secteur   Secteur @relation(fields: [secteurId], references: [id], onDelete: Cascade)
  fiche     Fiche   @relation(fields: [ficheId], references: [id], onDelete: Cascade)

  @@id([ficheId, secteurId])
}

model Mnemonique {
  id          String   @id @default(cuid())
  acronyme    String
  titre       String
  description String
  lettres     String
  contexte    String?
  couleur     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Abreviation {
  id         String   @id @default(cuid())
  sigle      String   @unique
  definition String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Poste {
  id               String             @id @default(cuid())
  slug             String             @unique
  nom              String
  typePoste        String
  lignes           String
  adresse          String
  horaires         String
  electrification  String
  systemeBlock     String
  annuaire         String
  circuitsVoie     String
  pnSensibles      String
  particularites   String
  proceduresCles   String
  dbc              String?
  rex              String?
  liens            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  secteurs         PosteSecteur[]
  proceduresMetier PosteProcedure[]
  sessionsMetier   SessionProcedure[]
  documents        Document[]
}

model PosteSecteur {
  posteId   String
  secteurId String
  secteur   Secteur @relation(fields: [secteurId], references: [id], onDelete: Cascade)
  poste     Poste   @relation(fields: [posteId], references: [id], onDelete: Cascade)

  @@id([posteId, secteurId])
}

model Procedure {
  id            String             @id @default(cuid())
  slug          String             @unique
  titre         String
  typeProcedure String
  description   String?
  version       String             @default("1.0")
  etapes        String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  postes        PosteProcedure[]
  sessions      SessionProcedure[]
}

model PosteProcedure {
  id          String    @id @default(cuid())
  posteId     String
  procedureId String
  ordre       Int       @default(0)
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  poste       Poste     @relation(fields: [posteId], references: [id], onDelete: Cascade)

  @@unique([posteId, procedureId])
}

model SessionProcedure {
  id                String                  @id @default(cuid())
  procedureId       String
  procedureVersion  String
  procedureSnapshot String
  posteId           String
  posteSlug         String
  agentNom          String?
  statut            String                  @default("en_cours")
  etapeIndex        Int                     @default(0)
  etat              String                  @default("{\"etapes\":{}}")
  synthese          String?
  startedAt         DateTime                @default(now())
  completedAt       DateTime?
  eventsArchived    Boolean                 @default(false)
  eventsArchivedAt  DateTime?
  /// Clé d'idempotence générée client-side. Voir FicheSession.clientOpId.
  clientOpId        String?                 @unique
  poste             Poste                   @relation(fields: [posteId], references: [id])
  procedure         Procedure               @relation(fields: [procedureId], references: [id])
  events            SessionProcedureEvent[]

  @@index([posteSlug])
  @@index([statut])
  @@index([eventsArchived, statut, completedAt])
}

model SessionProcedureEvent {
  id         String           @id @default(cuid())
  sessionId  String
  sequence   Int
  type       String
  etapeId    String?
  actionId   String?
  valeur     String?
  payload    String
  actorNom   String?
  occurredAt DateTime         @default(now())
  session    SessionProcedure @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, sequence])
  @@index([sessionId, occurredAt])
  @@index([type, occurredAt])
  @@index([actionId])
}

model SessionProcedureEventArchive {
  id         String   @id
  sessionId  String
  sequence   Int
  type       String
  etapeId    String?
  actionId   String?
  valeur     String?
  payload    String
  actorNom   String?
  occurredAt DateTime
  archivedAt DateTime @default(now())

  @@unique([sessionId, sequence])
  @@index([sessionId])
  @@index([occurredAt])
  @@index([actionId])
}

model AccesRail {
  id          String   @id @default(cuid())
  ligne       String
  pk          String
  type        String?
  identifiant String?
  nomAffiche  String
  nomComplet  String
  latitude    Float
  longitude   Float
  description String?
  source      String   @default("KML")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ligne])
  @@index([pk])
}

/// ⚠️  Règle métier — JAMAIS de prisma.user.delete depuis une route ou un script.
/// Les utilisateurs sont désactivés (actif=false) via `guardUserDeactivation`
/// (cf. src/app/api/admin/users/[id]/route.ts) pour préserver l'historique
/// opérationnel (sessions, logs, commentaires, contributions main courante).
///
/// Si une suppression physique devient nécessaire (RGPD), elle doit être faite
/// hors application via un script séparé, et après avoir mesuré l'impact sur les
/// relations ci-dessous.
///
/// Relations cascade :
///   - actionLogs / commentLogs : `onDelete: SetNull` — l'historique reste, le
///     nom de l'auteur disparaît (fallback UI "Utilisateur supprimé").
///   - documentsUploaded : `onDelete: SetNull` — le PDF reste utile, le nom de
///     l'uploadeur disparaît.
///   - sessions / mainCouranteSoumis : NOT NULL volontaire — l'identité du
///     créateur d'une session ou d'une contribution est un attribut métier
///     critique, jamais anonymisable. Le soft-delete couvre déjà ces cas.
model User {
  id                  String            @id @default(cuid())
  username            String            @unique
  password            String
  nom                 String
  prenom              String
  role                String            @default("USER")
  actif               Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  email               String?           @unique
  status              String            @default("approved")
  poste               String?
  motif               String?
  actionLogs          FicheActionLog[]
  commentLogs         FicheCommentLog[]
  sessions            FicheSession[]
  mainCouranteSoumis  MainCourante[]    @relation("MainCouranteAuteur")
  mainCouranteValidee MainCourante[]    @relation("MainCouranteValidatedBy")
  documentsUploaded   Document[]
  /// RCI et incidents CIL créés par cet utilisateur. `authorId` est NOT NULL :
  /// c'est la frontière de cloisonnement des modules RCI/CIL (cf. src/lib/auth.ts).
  /// Prisma applique donc Restrict — cohérent avec la règle de soft-delete.
  rcis                Rci[]
  cilIncidents        CilIncident[]
  /// Tournées terrain. Créateur / auteur NOT NULL : même règle que les
  /// sessions (soft-delete uniquement).
  tourneeModelesCrees     TourneeModele[]       @relation("TourneeModeleCreateur")
  tourneeRealisations     TourneeRealisation[]  @relation("TourneeRealisationCreateur")
  tourneeParticipations   TourneeParticipant[]
  tourneeContributions    TourneeContribution[] @relation("TourneeContributionAuteur")
  tourneeContribAffectees TourneeContribution[] @relation("TourneeContributionAssignee")
}

model FicheSession {
  id              String            @id @default(cuid())
  ficheSlug       String
  ficheTitre      String
  createdByUserId String
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  status          String            @default("active")
  /// Clé d'idempotence : UUID généré par le client à l'enfilage de l'op
  /// `session-create`. Permet au serveur d'ignorer un drain rejoué.
  clientOpId      String?           @unique
  actionLogs      FicheActionLog[]
  commentLogs     FicheCommentLog[]
  /// createdByUserId reste NOT NULL : une session "anonyme" n'a aucun sens
  /// métier (qui est responsable de l'opération en cours ?). Le soft-delete
  /// est la seule voie pour mettre un user de côté tout en gardant la trace
  /// des sessions qu'il a lancées.
  createdBy       User              @relation(fields: [createdByUserId], references: [id])
  /// RCI rédigés à partir de cette session (rattachement facultatif).
  rcis            Rci[]
  /// Incidents CIL décrivant le même événement (lien direct, facultatif).
  cilIncidents    CilIncident[]


  @@index([ficheSlug])
  @@index([status])
}

/// Log d'action (cochage/décochage) dans une session de fiche.
///
/// `userId` est nullable avec onDelete: SetNull — si l'utilisateur est
/// supprimé physiquement (hors application), le log reste pour l'audit
/// mais affiche "Utilisateur supprimé" (cf. getSessionJournal).
model FicheActionLog {
  id          String       @id @default(cuid())
  sessionId   String
  ficheSlug   String
  etapeOrdre  Int
  actionIndex Int
  actionLabel String
  userId      String?
  timestamp   DateTime     @default(now())
  type        String
  /// Clé d'idempotence générée client-side. Voir FicheSession.clientOpId.
  clientOpId  String?      @unique
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  session     FicheSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

/// Commentaire posté dans une session de fiche.
///
/// `userId` est nullable avec onDelete: SetNull — même règle que
/// FicheActionLog (préserver l'audit même si l'auteur disparaît).
model FicheCommentLog {
  id         String       @id @default(cuid())
  sessionId  String
  ficheSlug  String
  userId     String?
  timestamp  DateTime     @default(now())
  message    String
  /// Clé d'idempotence générée client-side. Voir FicheSession.clientOpId.
  clientOpId String?      @unique
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  session    FicheSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model MainCourante {
  id                String    @id @default(cuid())
  /// Titre court — saisi/édité uniquement par l'admin lors de la validation.
  titre             String?
  /// Code court de la nature (ex "S1", "S9", "RH"). Texte libre éditable par l'admin.
  nature            String?
  /// Libellé long de la catégorie (ex "Signaux"). Texte libre éditable par l'admin.
  libelle           String?
  /// Situation/cas rencontré (saisi par le contributeur).
  description       String
  /// Ce qui a été fait/conseillé (saisi par le contributeur, éditable par l'admin).
  solution          String?
  /// Avis de la filière sécurité — renseigné uniquement par l'admin.
  avisSecurite      String?
  /// Avis de la filière production — renseigné uniquement par l'admin.
  avisProduction    String?
  ficheSlug         String?
  auteurId          String
  status            String    @default("pending")
  /// Version éditée par l'admin de la description (legacy — conservée pour compat).
  editedDescription String?
  rejetMotif        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  validatedAt       DateTime?
  validatedByUserId String?
  /// Clé d'idempotence générée client-side. Voir FicheSession.clientOpId.
  clientOpId        String?   @unique
  /// auteurId reste NOT NULL : l'identité du contributeur fait partie
  /// intégrante de la donnée métier (responsabilité, contradictoire).
  /// Le soft-delete (`actif=false`) doit suffire — une suppression physique
  /// du compte est interdite tant qu'il a une MainCourante associée.
  auteur            User      @relation("MainCouranteAuteur", fields: [auteurId], references: [id])
  /// validatedByUserId : nullable + SetNull. Si l'admin valideur disparaît
  /// physiquement, la MainCourante reste validée — on perd juste le nom
  /// de l'admin (affichage "Validée par : (utilisateur supprimé)").
  validatedBy       User?     @relation("MainCouranteValidatedBy", fields: [validatedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([auteurId])
  @@index([createdAt])
  @@index([nature])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  userId     String
  userNom    String
  action     String
  resource   String
  resourceId String
  detail     String?
  timestamp  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([userId])
  @@index([timestamp])
}

/// Collection de liens utiles (référentiel). Fiches, secteurs, postes et étapes
/// de procédure peuvent référencer une entrée via son id (cf. type LienRef).
model Lien {
  id          String         @id @default(cuid())
  libelle     String
  url         String
  ordre       Int            @default(0)
  categorieId String?
  categorie   LienCategorie? @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categorieId])
}

/// Thématique de la page « Liens utiles » (hub). Porte un nom, une icône
/// (clé Lucide) et une couleur d'accent.
model LienCategorie {
  id        String   @id @default(cuid())
  nom       String
  icon      String   @default("Link2")
  couleur   String   @default("blue")
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  liens     Lien[]
}

/// Relevé de Constatations Immédiates.
///
/// ⚠️ Cloisonnement : la frontière d'accès est `authorId`, PAS `teamId`.
/// Cette application n'a pas de notion d'équipe ; `teamId` est conservé comme
/// champ technique inerte (exigé par le bundle portable-rci-cil) et ne doit
/// JAMAIS servir de mécanisme de sécurité. Voir `teamScope` / `assertTeamAccess`
/// dans src/lib/auth.ts.
model Rci {
  id            String    @id @default(cuid())
  /// Champ technique inerte — vestige du modèle multi-équipes du bundle d'origine.
  /// Non utilisé pour le contrôle d'accès. Voir le commentaire du modèle.
  teamId        String
  /// Auteur (créateur du brouillon).
  authorId      String
  /// DRAFT | FINAL — FINAL = .docx généré et transmis, gel en lecture seule.
  status        String    @default("DRAFT")
  /// Numéro de dossier normé JJMMAAHHMM-Lieu (auto-généré côté client).
  dossierNumber String?
  /// Horodatage de l'événement (source de vérité, redondant avec le payload).
  eventAt       DateTime?
  /// Titre court pour l'affichage en liste (nature + lieu).
  title         String?
  /// `true` = titre proposé automatiquement (depuis la source / la Nature) et
  /// encore non personnalisé : il peut évoluer avec la Nature du wizard. Passe à
  /// `false` dès que l'agent édite le champ « Titre court » — le titre devient
  /// alors prioritaire et n'est plus jamais remplacé par un autosave.
  titleAuto     Boolean   @default(false)
  /// Payload JSON des champs du wizard (stringifié, parsé côté app).
  payload       String    @default("{}")
  /// Rattachement facultatif à la source terrain de l'événement — sert à la
  /// navigation entre modules et au pré-remplissage. Exclusifs en pratique
  /// (l'UI n'en propose qu'un), mais non contraints en base : un RCI peut
  /// naître d'une session puis être relié à un CIL ouvert plus tard.
  cilIncidentId String?
  sessionId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author      User          @relation(fields: [authorId], references: [id])
  /// SetNull : la suppression d'un CIL ou d'une session ne doit jamais
  /// emporter le RCI, qui est un document à valeur probante autonome.
  cilIncident CilIncident?  @relation(fields: [cilIncidentId], references: [id], onDelete: SetNull)
  session     FicheSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([authorId])
  @@index([updatedAt])
  @@index([cilIncidentId])
  @@index([sessionId])
}

/// Incident CIL (Chef d'Incident Local).
/// ⚠️ Même règle que `Rci` : cloisonnement par `authorId`, `teamId` inerte.
model CilIncident {
  id               String    @id @default(cuid())
  /// Champ technique inerte — non utilisé pour le contrôle d'accès.
  teamId           String
  authorId         String
  /// Cycle de vie dur : OPEN | CLOSED. Réouverture réservée EDITOR/ADMIN.
  status           String    @default("OPEN")
  /// Référence normée auto (JJMMAAHHMM-Lieu), non unique (comme Rci.dossierNumber).
  reference        String?
  /// INCENDIE | ACCIDENT_PERSONNE | OBSTACLE | AUTRE
  type             String
  typeLibre        String?
  /// Horodatage de l'incident (date + heure).
  occurredAt       DateTime
  lieu             String
  poste            String?
  voie             String?
  observations     String?
  /// Localisation choisie UNE FOIS pour tout le livret (imprimé : « entre les
  /// gares de … et de … » OU « en gare de … », mutuellement exclusifs).
  /// gareMode ∈ { UNIQUE, BETWEEN }.
  gareMode         String?
  gareUnique       String?
  gareA            String?
  gareB            String?
  /// Éléments de géométrie saisis UNE fois et repris par défaut dans chaque
  /// dépêche (modifiables ponctuellement depuis la fiche incident).
  voies            String?
  km               String?
  acLabel          String?
  motif            String?
  /// En-tête CIL (imprimé officiel).
  cilNom           String?
  cilPrenom        String?
  /// EIC_RAL | INFP_RH | INFP_LGV (cases de l'imprimé).
  cilEtablissement String?
  /// Heure « Désigné(e) à ».
  designatedAt     DateTime?
  /// Arrivée sur site → bascule responsabilité protections CRC→CIL.
  arrivedOnSiteAt  DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// Session de fiche réflexe décrivant le MÊME événement. Lien direct
  /// (facultatif) : session, Livret CIL et RCI forment un triangle de modules
  /// mutuellement navigables. Posé notamment quand le Livret est créé depuis
  /// une session. `SetNull` : détruire la session ne détruit pas le livret.
  sessionId        String?

  author        User              @relation(fields: [authorId], references: [id])
  session       FicheSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  events        CilEvent[]
  depeches      CilDepeche[]
  intervenants  CilIntervenant[]
  signatures    CilSignature[]
  autorisations CilAutorisation[]
  /// RCI rédigés à partir de cet incident (rattachement facultatif).
  rcis          Rci[]


  @@index([teamId, status])
  @@index([authorId])
  @@index([sessionId])
}

model CilEvent {
  id         String   @id @default(cuid())
  incidentId String
  /// INCIDENT_CREATED | MISSION_CIL | ARRIVAL_ON_SITE | DEPECHE |
  /// INTERVENANT_ARRIVAL | INTERVENANT_DEPARTURE | REPRISE_PARTIELLE_CIRCULATION |
  /// REPRISE_CIRCULATION | RETABLISSEMENT_PARTIEL_TENSION | RETABLISSEMENT_TENSION |
  /// CHANGEMENT_CIL | CLOSURE | NOTE
  type       String
  occurredAt DateTime
  /// Ordre de saisie (tie-breaker) : max(seq)+1 par incident dans la transaction.
  seq        Int
  label      String
  note       String?
  /// Auteur figé (survit à la suppression/renommage).
  actorId    String?
  actorName  String?
  /// Lien vers l'entité métier : DEPECHE | INTERVENANT (id dans refId).
  refType    String?
  refId      String?
  /// Données structurées additionnelles (JSON string). Ex. autorisation reprise.
  metadata   String?
  createdAt  DateTime @default(now())

  incident CilIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, occurredAt, seq])
}

model CilDepeche {
  id                   String    @id @default(cuid())
  incidentId           String
  /// L'événement DEPECHE créé avec cette dépêche (le temps y vit).
  eventId              String    @unique
  /// PROTECTION_CIRCULATION | PROTECTION_ELECTRIQUE | REPRISE_PARTIELLE |
  /// REPRISE_NORMALE | RETABLISSEMENT_PARTIEL | RETABLISSEMENT_NORMAL | LIBRE
  subtype              String
  /// Destinataire numéroté de la dépêche (imprimé 2024) : CRC | RSS | AC | LIBRE.
  /// Une protection donne 2 dépêches (CRC + RSS pour l'électrique / CRC + AC
  /// pour la circulation) ; reprises/rétablissements = CRC ; carnet = LIBRE.
  interlocutor         String?
  /// RECU | EXPEDIE (dépêches libres uniquement).
  sens                 String?
  texte                String
  /// Numéro donné par le CIL (réservé dans la plage du subtype). Unique/incident.
  numeroDonne          Int
  numeroRecu           String?
  collationne          Boolean   @default(false)
  /// Horodatages d'avis (imprimé officiel — protections/reprises/rétablissements).
  avisCrcAt            DateTime?
  avisCosAt            DateTime?
  avisOpjAt            DateTime?
  /// Rétablissement : départ effectif constaté.
  departEffectifAt     DateTime?
  /// ACCORD_COS | ACCORD_OPJ | TOUS_PARTIS (reprises/rétablissements).
  repriseAuthorization String?
  /// Géométrie non temporelle (JSON string) : voies, km, gareA, gareB,
  /// gareUnique, motif, marcheInterdite, marchePrudente, marcheNormale.
  metadata             String?
  createdAt            DateTime  @default(now())

  incident      CilIncident              @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  destinataires CilDepecheDestinataire[]

  @@unique([incidentId, numeroDonne])
  @@index([incidentId, subtype])
}

model CilDepecheDestinataire {
  id         String  @id @default(cuid())
  depecheId  String
  label      String
  numeroRecu String?

  depeche CilDepeche @relation(fields: [depecheId], references: [id], onDelete: Cascade)

  @@index([depecheId])
}

model CilIntervenant {
  id         String    @id @default(cuid())
  incidentId String
  /// COS | OPJ | POMPES_FUNEBRES | EIC | EF | INFRAPOLE | INFP | AUTRE
  type       String
  typeLibre  String?
  nom        String?
  tel        String?
  arrivedAt  DateTime?
  departedAt DateTime?
  createdAt  DateTime  @default(now())

  incident CilIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model CilAutorisation {
  id         String   @id @default(cuid())
  incidentId String
  /// Sous-type de dépêche visé (REPRISE_PARTIELLE, RETABLISSEMENT_NORMAL, …) :
  /// une autorisation vaut pour UNE action précise, pas pour tout l'incident.
  subtype    String
  /// COS | OPJ
  role       String
  grantedAt  DateTime
  signerName String?
  /// PNG base64 (sans préfixe data:), comme les signatures RCI.
  imageB64   String
  createdAt  DateTime @default(now())

  incident CilIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, subtype, role])
  @@index([incidentId])
}

model CilSignature {
  id         String   @id @default(cuid())
  incidentId String
  /// INCIDENT | EVENT | DEPECHE | INTERVENANT
  ownerType  String
  ownerId    String
  signerName String?
  signerRole String?
  /// PNG base64 (sans préfixe data:), comme les signatures RCI.
  imageB64   String
  createdAt  DateTime @default(now())

  incident CilIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([ownerType, ownerId])
}

// ═══════════════════════════════════════════════════════════════════════════
// TOURNÉES TERRAIN
//
// Séparation stricte :
//   • TourneeModele / TourneeEtape  → parcours préparé (back-office, ADMIN)
//   • TourneeRealisation            → exécution réelle (solo ou équipe) ; porte
//     une COPIE FIGÉE du modèle (`planSnapshot`) : modifier le modèle n'altère
//     jamais une réalisation, et l'ajustement d'une réalisation par son
//     référent ne remonte jamais dans le modèle.
//   • TourneeParticipant / TourneeEvenement → progression INDIVIDUELLE
//     (journal append-only horodaté par le terminal, source des durées réelles)
//   • TourneeContribution           → remontée terrain indépendante, traitée
//     administrativement, ne modifie jamais le modèle.
// ═══════════════════════════════════════════════════════════════════════════

model TourneeModele {
  id               String   @id @default(cuid())
  titre            String
  /// Sous-titre affiché sous le titre (ex. « Secteur RDN »).
  sousTitre        String?
  description      String?
  objectif         String?
  /// JSON TourneeAProposSection[] — rubrique « À propos de cette tournée ».
  aPropos          String   @default("[]")
  /// Heure de départ prévue "HH:mm" (heure locale Europe/Paris). La date
  /// appartient à la réalisation.
  heureDepart      String   @default("08:00")
  /// JSON TourneeSeuils — tolérance / seuils orange-rouge / marge de confort.
  seuils           String?
  /// JSON TourneeContactRef[] — fonction propre à la tournée + contact lié ou libre.
  contacts         String   @default("[]")
  /// LienRef[] généraux de la tournée.
  liens            String?
  /// Mention de diffusion imprimée en pied de page du PDF.
  mentionDiffusion String?
  /// BROUILLON | PUBLIE | ARCHIVE — seuls les modèles PUBLIE sont proposés.
  statut           String   @default("BROUILLON")
  /// Incrémentée à chaque enregistrement — tracée dans la réalisation.
  version          Int      @default(1)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy     User                  @relation("TourneeModeleCreateur", fields: [createdById], references: [id])
  etapes        TourneeEtape[]
  realisations  TourneeRealisation[]
  contributions TourneeContribution[]

  @@index([statut])
}

model TourneeEtape {
  id                  String   @id @default(cuid())
  modeleId            String
  ordre               Int      @default(0)
  /// DEPART | POINT | PAUSE | EXERCICE | RESTITUTION
  type                String   @default("POINT")
  titre               String
  description         String?
  /// Étape optionnelle : hors chaîne horaire, réalisable si la marge le permet.
  optionnelle         Boolean  @default(false)
  /// Heure imposée "HH:mm" (échéance : réservation, rendez-vous, restitution).
  heureImposee        String?
  /// Temps de présence prévu (minutes).
  dureeMin            Int      @default(0)
  /// Trajet vers l'étape obligatoire suivante (minutes) — valeur de
  /// planification fixée par le créateur, jamais recalculée.
  trajetSuivanteMin   Int      @default(0)
  /// Étape optionnelle : surcoût de trajet induit par le détour (minutes).
  surcoutTrajetMin    Int?
  adresse             String?
  latitude            Float?
  longitude           Float?
  /// Localisation volontairement non communiquée aux participants (exercice).
  localisationMasquee Boolean  @default(false)
  /// LienRef[] — référentiels / documents de l'étape.
  liens               String?
  /// JSON TourneeBloc[] — consignes structurées (sections, encadrés, sous-points).
  contenu             String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  modele TourneeModele @relation(fields: [modeleId], references: [id], onDelete: Cascade)
  photos Document[]

  @@index([modeleId, ordre])
}

model TourneeRealisation {
  id            String    @id @default(cuid())
  /// SetNull : supprimer un modèle ne détruit pas l'historique.
  modeleId      String?
  modeleVersion Int       @default(1)
  /// Copie figée JSON TourneePlan (modèle + étapes) — ajustable par le
  /// référent tant que la réalisation est en PREPARATION.
  planSnapshot  String
  /// SOLO | EQUIPE
  mode          String
  titre         String
  /// Jour de la tournée "YYYY-MM-DD" (jour local Europe/Paris).
  date          String
  /// Heure de départ prévue "HH:mm" (copie ajustable de celle du modèle).
  heureDepart   String
  /// PREPARATION | EN_COURS | TERMINEE | ANNULEE
  statut        String    @default("PREPARATION")
  /// Code court de partage (mode EQUIPE uniquement).
  codePartage   String?   @unique
  createdById   String
  startedAt     DateTime?
  endedAt       DateTime?
  clientOpId    String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  modele        TourneeModele?        @relation(fields: [modeleId], references: [id], onDelete: SetNull)
  createdBy     User                  @relation("TourneeRealisationCreateur", fields: [createdById], references: [id])
  participants  TourneeParticipant[]
  evenements    TourneeEvenement[]
  contributions TourneeContribution[]

  @@index([statut, mode])
  @@index([createdById])
}

model TourneeParticipant {
  id                  String    @id @default(cuid())
  realisationId       String
  userId              String
  /// REFERENT | PARTICIPANT
  role                String    @default("PARTICIPANT")
  joinedAt            DateTime  @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  /// Projection (dérivée du journal) pour la vue équipe.
  etapeCouranteKey    String?
  etapeCouranteDepuis DateTime?

  realisation TourneeRealisation @relation(fields: [realisationId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id])
  evenements  TourneeEvenement[]

  @@unique([realisationId, userId])
}

model TourneeEvenement {
  id            String   @id @default(cuid())
  realisationId String
  participantId String
  /// TOURNEE_DEBUT | ETAPE_DEBUT | ETAPE_FIN | ETAPE_IGNOREE | ETAPE_REPRISE | TOURNEE_FIN
  type          String
  /// Id d'étape dans la copie figée (stable même si le modèle évolue).
  etapeKey      String?
  /// Horodatage du terminal (source des durées réelles, permet le hors ligne).
  occurredAt    DateTime
  recordedAt    DateTime @default(now())
  clientOpId    String?  @unique

  realisation TourneeRealisation @relation(fields: [realisationId], references: [id], onDelete: Cascade)
  participant TourneeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, occurredAt])
  @@index([realisationId])
}

model TourneeContribution {
  id            String    @id @default(cuid())
  realisationId String?
  modeleId      String?
  /// Id d'étape (copie figée) + titre figé pour l'affichage.
  etapeKey      String?
  etapeTitre    String?
  auteurId      String
  /// REMISE_CONFORMITE | ANOMALIE | INFO_A_MODIFIER | AMELIORATION | PHOTO | AUTRE
  type          String
  description   String
  /// NOUVELLE | EN_ANALYSE | A_TRAITER | EN_COURS | TRAITE | REFUSE | ARCHIVE
  statut        String    @default("NOUVELLE")
  assigneeId    String?
  traiteLe      DateTime?
  clientOpId    String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  realisation TourneeRealisation? @relation(fields: [realisationId], references: [id], onDelete: SetNull)
  modele      TourneeModele?      @relation(fields: [modeleId], references: [id], onDelete: SetNull)
  auteur      User                @relation("TourneeContributionAuteur", fields: [auteurId], references: [id])
  assignee    User?               @relation("TourneeContributionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  historique  TourneeContributionHistorique[]
  photos      Document[]

  @@index([statut])
  @@index([auteurId])
  @@index([modeleId])
  @@index([createdAt])
}

/// Historique append-only du traitement d'une contribution.
model TourneeContributionHistorique {
  id             String   @id @default(cuid())
  contributionId String
  /// CREATION | STATUT | COMMENTAIRE | AFFECTATION | DATE_TRAITEMENT
  type           String
  ancienneValeur String?
  nouvelleValeur String?
  message        String?
  /// Auteur figé (survit au renommage / soft-delete).
  actorId        String?
  actorNom       String
  createdAt      DateTime @default(now())

  contribution TourneeContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@index([contributionId, createdAt])
}
